# Python 垃圾文件
venv/                           # 忽略 Python 虚拟环境目录
.venv/                          # 忽略 Python 虚拟环境目录
__pycache__/                    # 忽略 Python 编译缓存目录
*.pyc                           # 忽略 Python 编译文件
*.pyo                           # 忽略 Python 优化编译文件
.idea/                          # 忽略 PyCharm 等 IDE 配置文件
.vscode/                        # 忽略 VSCode 配置文件

# 前端 垃圾文件 (最重要的在这里！)
node_modules/                   # 忽略前端依赖包目录
dist/                           # 忽略前端打包输出目录
build/                          # 忽略前端构建目录
.npm/                           # 忽略 npm 缓存目录
# 下方原本的 package-lock.json 和 yarn.lock 已被安全删除，以确保团队协作时依赖版本严格锁定

# 数据库文件 (不要上传数据库)
*.sqlite3                       # 忽略 SQLite 数据库文件，防止本地测试数据污染代码库
*.db                            # 忽略通用数据库文件

# 系统文件
.DS_Store                       # 忽略 macOS 系统自动生成的隐藏桌面文件